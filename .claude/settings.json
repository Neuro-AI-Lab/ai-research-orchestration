{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(md5sum:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(pytest:*)",
      "Bash(python3 .claude/scripts/lit_search.py:*)",
      "Bash(python3 .claude/scripts/zotero_mcp.py:*)",
      "Bash(python3 .claude/scripts/sweep_summary.py:*)",
      "Bash(.claude/scripts/run_with_status.sh:*)",
      "Bash(.claude/scripts/overleaf_sync.sh:*)",
      "mcp__literature__lit_search",
      "mcp__literature__lit_fetch",
      "mcp__zotero__zotero_search",
      "mcp__zotero__zotero_item",
      "mcp__zotero__zotero_fulltext",
      "mcp__zotero__zotero_bibtex",
      "mcp__zotero__zotero_collections",
      "mcp__zotero__zotero_add"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/experiment_gate.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_brief.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/result_contract_gate.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_close_gate.py\""
          }
        ]
      }
    ]
  }
}
